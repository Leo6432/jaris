# Copie ce fichier en `.env` et remplis les valeurs avant `npm run dev`.
# Aucune valeur ici n'est un service payant. Exception à "zéro compte" : la
# reconnaissance vocale (Cohere Transcribe) demande un compte Hugging Face
# gratuit (voir plus bas) ; le déclenchement (mot d'activation "Jaris") et la
# synthèse vocale (Supertonic HD) restent sans aucun compte.

# --- Sidecar Python (mot d'activation "Jaris" + reconnaissance vocale) ---
PYTHON_BIN=python
# Index du micro à utiliser (voir `python -m sounddevice`), vide = défaut système
MIC_INPUT_DEVICE=

# --- Reconnaissance vocale (Parakeet v3, NVIDIA) ---
# Aucun réglage : le modèle et sa version exacte sont épinglés dans python/voice_server.py (étape 158).
# Tourne sur le processeur, en RAM (~2,5 Go) : toute la carte graphique reste au modèle de conversation.

# --- Synthèse vocale (Supertonic HD) ---
# Voix naturelle, modèle léger (99M paramètres) téléchargé automatiquement
# au premier lancement — rien à faire à la main. Changeable aussi depuis le
# menu Options de l'appli (aperçu + sélection en un clic).
# Voix dispo : M1 (vive), M2 (grave, sérieuse), M3 (autoritaire, confiante),
# M4 (douce, jeune), M5 (chaleureuse, narrative), F1 à F5 (équivalents féminins)
TTS_VOICE=M3
TTS_LANGUAGE=fr

# --- LLM de raisonnement (Ollama) — utilisé à partir de l'étape 4 ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# Fenêtre de contexte : garde-la basse pour que le modèle tienne en entier
# dans la VRAM (le max du modèle, ex: 131072 pour qwen3.5, ferait déborder
# sur le CPU et ralentirait beaucoup les réponses). 8192, pas moins : le
# système prompt + la liste des outils de Jaris consomment déjà environ
# 4200-4500 tokens à eux seuls, une valeur plus basse peut faire déborder
# le budget de réponse avant même le premier message (constaté en usage
# réel sur le plus petit modèle du palier Rapide).
OLLAMA_NUM_CTX=8192
# Modèle de vision d'écran (étape 6), séparé du modèle de conversation
# ("ollama pull qwen3-vl:8b" avant de l'utiliser)
OLLAMA_VISION_MODEL=qwen3-vl:8b

# --- Recherche web (SearXNG, étape 7) — "docker compose up -d" avant usage ---
# 8091, pas le 8080 par défaut de SearXNG : voir docker-compose.yml (port trop souvent déjà pris par un
# autre logiciel sur la machine de l'utilisateur).
SEARXNG_HOST=http://127.0.0.1:8091
