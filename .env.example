# Copie ce fichier en `.env` et remplis les valeurs avant `npm run dev`.
# Aucune valeur ici n'est un service payant : ni compte ni clé requis pour
# la voix, tout tourne en local (openWakeWord, faster-whisper, Piper).

# --- Sidecar Python (mot d'activation + reconnaissance vocale) ---
PYTHON_BIN=python

# --- Mot d'activation (openWakeWord) ---
# Le mot-clé "Jaris" n'existe pas en pré-entraîné : le plus proche livré par
# openWakeWord est "Hey Jarvis" (anglais). Dis "Hey Jarvis" pour activer Jaris.
# Récupère les 3 fichiers via `python python/download_wakeword_models.py`.
WAKEWORD_MODEL_PATH=./models/wakeword/hey_jarvis_v0.1.onnx
WAKEWORD_MELSPEC_PATH=./models/wakeword/melspectrogram.onnx
WAKEWORD_EMBEDDING_PATH=./models/wakeword/embedding_model.onnx
# Entre 0 et 1 : plus bas = plus sensible (plus de faux positifs)
WAKEWORD_THRESHOLD=0.5
# Index du micro à utiliser (voir `python -m sounddevice`), vide = défaut système
WAKEWORD_INPUT_DEVICE=

# --- Reconnaissance vocale (faster-whisper) ---
# tiny / base / small / medium / large-v3 / large-v3-turbo — plus gros =
# plus précis mais plus lent et plus gourmand en VRAM. "small" est rapide
# mais se trompe parfois sur des mots rares (ex: "arobase") ; "large-v3-turbo"
# est une version allégée de large-v3, quasi aussi précise mais bien plus
# rapide (recommandé).
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=fr
# "cuda" sur la RTX 3070, "cpu" si pas de GPU dispo
WHISPER_DEVICE=cuda
# float16 sur GPU (~3 Go pour large-v3), int8 sur CPU ou si la VRAM est
# serrée avec Ollama chargé en même temps (~1,5 Go pour large-v3, précision
# quasi identique à float16)
WHISPER_COMPUTE_TYPE=int8

# --- Synthèse vocale (Piper) ---
PIPER_BIN_PATH=./bin/piper/piper.exe
PIPER_VOICE_PATH=./models/tts/fr_FR-siwis-medium.onnx

# --- LLM de raisonnement (Ollama) — utilisé à partir de l'étape 4 ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# Fenêtre de contexte : garde-la basse pour que le modèle tienne en entier
# dans la VRAM (le max du modèle, ex: 131072 pour qwen3.5, ferait déborder
# sur le CPU et ralentirait beaucoup les réponses)
OLLAMA_NUM_CTX=4096
# Modèle de vision d'écran (étape 6), séparé du modèle de conversation
# ("ollama pull qwen3-vl:8b" avant de l'utiliser)
OLLAMA_VISION_MODEL=qwen3-vl:8b

# --- Recherche web (SearXNG, étape 7) — "docker compose up -d" avant usage ---
SEARXNG_HOST=http://127.0.0.1:8080

# --- Envoi de mails, option recommandée : compte Gmail via OAuth (étape 11) ---
# Se connecte depuis le bouton "Options" en haut à gauche de l'appli, aucun
# mot de passe à taper. Nécessite un identifiant OAuth "Application de
# bureau" créé sur https://console.cloud.google.com/apis/credentials
# (voir le README pour les étapes détaillées).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Envoi de mails, option de secours : SMTP classique (étape 11) ---
# Utilisé uniquement si aucun compte Gmail n'est connecté ci-dessus.
# Exemple Gmail : smtp.gmail.com, port 587, et un mot de passe d'application
# (pas ton mot de passe normal) généré sur myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
# true pour le port 465 (SSL direct), false pour 587/25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Adresse affichée comme expéditeur, vide = identique à SMTP_USER
SMTP_FROM=
