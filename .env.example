# Copie ce fichier en `.env` et remplis les valeurs avant `npm run dev`.
# Aucune valeur ici n'est un service payant. Exception à "zéro compte" : la
# reconnaissance vocale (Cohere Transcribe) demande un compte Hugging Face
# gratuit (voir plus bas) ; le déclenchement (double clap) et la synthèse
# vocale (Supertonic HD) restent sans aucun compte.

# --- Sidecar Python (déclenchement par double clap + reconnaissance vocale) ---
PYTHON_BIN=python
# Index du micro à utiliser (voir `python -m sounddevice`), vide = défaut système
MIC_INPUT_DEVICE=

# --- Reconnaissance vocale (Cohere Transcribe) ---
# Modèle #1 du Open ASR Leaderboard (5,42% d'erreur moyenne), open source
# (Apache 2.0), ~4 Go en VRAM (float16 sur GPU, float32 sur CPU).
# Laisse VIDE : le modèle par défaut (et la version exacte épinglée qui va
# avec) est défini dans python/voice_server.py. C'est une copie non protégée
# du modèle officiel, aux poids rigoureusement identiques (même empreinte
# SHA256) : aucun compte Hugging Face n'est nécessaire, rien à accepter en
# ligne. Ne remplis cette ligne que pour imposer un AUTRE modèle — s'il est
# "gated", il faudra alors un compte et `hf auth login`.
STT_MODEL=
STT_LANGUAGE=fr
# Vide = détection automatique (GPU si utilisable, sinon processeur).
# Mets "cuda" ou "cpu" seulement pour forcer l'un des deux.
STT_DEVICE=

# --- Synthèse vocale (Supertonic HD) ---
# Voix naturelle, modèle léger (99M paramètres) téléchargé automatiquement
# au premier lancement — rien à faire à la main. Changeable aussi depuis le
# menu Options de l'appli (aperçu + sélection en un clic).
# Voix dispo : M1 (vive), M2 (grave, sérieuse), M3 (autoritaire, confiante),
# M4 (douce, jeune), M5 (chaleureuse, narrative), F1 à F5 (équivalents féminins)
TTS_VOICE=M3
TTS_LANGUAGE=fr

# --- LLM de raisonnement (Ollama) — utilisé à partir de l'étape 4 ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# Fenêtre de contexte : garde-la basse pour que le modèle tienne en entier
# dans la VRAM (le max du modèle, ex: 131072 pour qwen3.5, ferait déborder
# sur le CPU et ralentirait beaucoup les réponses)
OLLAMA_NUM_CTX=4096
# Modèle de vision d'écran (étape 6), séparé du modèle de conversation
# ("ollama pull qwen3-vl:8b" avant de l'utiliser)
OLLAMA_VISION_MODEL=qwen3-vl:8b

# --- Recherche web (SearXNG, étape 7) — "docker compose up -d" avant usage ---
SEARXNG_HOST=http://127.0.0.1:8080

# --- Envoi de mails, option recommandée : compte Gmail via OAuth (étape 11) ---
# Se connecte depuis le bouton "Options" en haut à gauche de l'appli, aucun
# mot de passe à taper. Nécessite un identifiant OAuth "Application de
# bureau" créé sur https://console.cloud.google.com/apis/credentials
# (voir le README pour les étapes détaillées).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Envoi de mails, option de secours : SMTP classique (étape 11) ---
# Utilisé uniquement si aucun compte Gmail n'est connecté ci-dessus.
# Exemple Gmail : smtp.gmail.com, port 587, et un mot de passe d'application
# (pas ton mot de passe normal) généré sur myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
# true pour le port 465 (SSL direct), false pour 587/25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Adresse affichée comme expéditeur, vide = identique à SMTP_USER
SMTP_FROM=
