# Copie ce fichier en `.env` et remplis les valeurs avant `npm run dev`.
# Aucune valeur ici n'est un service payant : Picovoice Porcupine a un palier
# "Personal use" gratuit (compte requis, pas de carte bancaire).

# --- Mot d'activation "Jaris" (Porcupine) ---
# Clé gratuite : https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=
# Fichier .ppn du mot-clé "Jaris" entraîné sur console.picovoice.ai
# (Access Keys > Create Wake Word > "Jaris" > télécharger pour Windows)
PORCUPINE_KEYWORD_PATH=./models/wakeword/Jaris_windows.ppn
# Entre 0 (moins de faux négatifs) et 1 (moins de faux positifs)
PORCUPINE_SENSITIVITY=0.6

# --- Reconnaissance vocale (faster-whisper, sidecar Python) ---
PYTHON_BIN=python
# tiny / base / small / medium / large-v3 — "small" est un bon compromis FR
WHISPER_MODEL=small
WHISPER_LANGUAGE=fr
# "cuda" sur la RTX 3070, "cpu" si pas de GPU dispo
WHISPER_DEVICE=cuda
# float16 sur GPU, int8 sur CPU
WHISPER_COMPUTE_TYPE=float16

# --- Synthèse vocale (Piper) ---
PIPER_BIN_PATH=./bin/piper/piper.exe
PIPER_VOICE_PATH=./models/tts/fr_FR-siwis-medium.onnx

# --- LLM de raisonnement (Ollama) — utilisé à partir de l'étape 4 ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
